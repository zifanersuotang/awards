@[reducible] def Erdos79.GraphCode : Type :=
(n : ℕ) × SimpleGraph.{0} (Fin n)
@[reducible] def Erdos79.GraphCode.graph : (G : Erdos79.GraphCode) → SimpleGraph.{0} (Fin G.vertexCount) :=
fun G => Sigma.snd.{0, 0} G
def Erdos79.GraphCode.edgeCount : Erdos79.GraphCode → ℕ :=
fun G => Nat.card.{0} ↑(SimpleGraph.edgeSet.{0} G.graph)
def Erdos79.NoIsolated : Erdos79.GraphCode → Prop :=
fun G => ∀ (v : Fin G.vertexCount), ¬SimpleGraph.IsIsolated.{0} G.graph v
@[reducible] def Erdos79.IsContained : Erdos79.GraphCode → Erdos79.GraphCode → Prop :=
fun F G => SimpleGraph.IsContained.{0, 0} F.graph G.graph
def Erdos79.RamseyAt : Erdos79.GraphCode → Erdos79.GraphCode → ℕ → Prop :=
fun F H N =>
  ∀ (C : SimpleGraph.{0} (Fin N)),
    SimpleGraph.IsContained.{0, 0} F.graph C ∨ SimpleGraph.IsContained.{0, 0} H.graph (compl.{0} C)
def Erdos79.graphRamseyNumber : Erdos79.GraphCode → Erdos79.GraphCode → ℕ :=
fun F H => Nat.find ⋯
def Erdos570.cycleCode : ℕ → Erdos79.GraphCode :=
fun k => Sigma.mk.{0, 0} k (SimpleGraph.cycleGraph k)
