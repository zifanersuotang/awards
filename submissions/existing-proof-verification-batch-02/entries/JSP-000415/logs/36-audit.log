def Erdos518.IsPath.{u} : {V : Type u} → SimpleGraph.{u} V → List.{u} V → Prop :=
fun {V} G p => Ne.{u + 1} p List.nil.{u} ∧ List.Nodup.{u} p ∧ List.IsChain.{u} (SimpleGraph.Adj.{u} G) p
def Erdos518.pathWalk.{u} : {V : Type u} →
  {G : SimpleGraph.{u} V} →
    {p : List.{u} V} →
      (hp : Erdos518.IsPath.{u} G p) → SimpleGraph.Walk.{u} G (List.head.{u} p ⋯) (List.getLast.{u} p ⋯) :=
fun {V} {G} {p} hp => SimpleGraph.Walk.ofSupport.{u} p ⋯ ⋯
def Erdos518.IsPathCover.{u} : {V : Type u} → SimpleGraph.{u} V → List.{u} (List.{u} V) → Prop :=
fun {V} G ps =>
  (∀ (p : List.{u} V), Membership.mem.{u, u} ps p → Erdos518.IsPath.{u} G p) ∧
    ∀ (v : V), ∃ p, Membership.mem.{u, u} ps p ∧ Membership.mem.{u, u} p v
def Erdos518.HasPathCoverAtMost.{u} : {V : Type u} → SimpleGraph.{u} V → ℕ → Prop :=
fun {V} G k => ∃ ps, LE.le.{0} (List.length.{u} ps) k ∧ Erdos518.IsPathCover.{u} G ps
def Erdos518.Erdos518For : (n : ℕ) → SimpleGraph.{0} (Fin n) → Prop :=
fun n G => Erdos518.HasPathCoverAtMost.{0} G n.sqrt ∨ Erdos518.HasPathCoverAtMost.{0} (compl.{0} G) n.sqrt
def Erdos518.Erdos518ForType.{u} : {V : Type u} → [Fintype.{u} V] → SimpleGraph.{u} V → Prop :=
fun {V} [Fintype.{u} V] G =>
  Erdos518.HasPathCoverAtMost.{u} G (Fintype.card.{u} V).sqrt ∨
    Erdos518.HasPathCoverAtMost.{u} (compl.{u} G) (Fintype.card.{u} V).sqrt
Erdos518.erdos_518 : ∀ (n : ℕ) (G : SimpleGraph.{0} (Fin n)), Erdos518.Erdos518For n G
'Erdos518.erdos_518' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
