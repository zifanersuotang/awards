{
  "schema_version": 1,
  "jsp": "JSP-000521",
  "erdos": 641,
  "title": "Does sufficiently high chromatic number force several edge-disjoint cycles on the same vertex set?",
  "scope": "No function F of the number of cycles can ensure that every finite graph with chromatic number at least F(r) contains r pairwise edge-disjoint cycles on exactly the same nonempty vertex set. The failure already holds at r=2: for every chromatic threshold there is a finite graph with no nonempty 4-regular subgraph, whereas two such cycles would give one. No quantitative rate in terms of the exact number of vertices is claimed.",
  "attribution": "Existing plby/lean-proofs formalization. Primary header credits Barnabas Janzer, Richard Steiner and Benny Sudakov for the informal result, and Codex / GPT-5.6 Sol for formalization. It also retains the Formal Conjectures Authors 2026 copyright and Apache-2.0 modification notice. Original names, accents and all dependency notices remain byte-for-byte unchanged in the 33 copied sources. No uploader-as-original-author, new-proof, first-proof or recipient claim.",
  "target_module": "ErdosProblems.Erdos641",
  "main_theorem": "Erdos641.not_erdos_641",
  "theorems": [
    "Erdos641.isRegularOfDegree_four_sup",
    "Erdos641.containsRegularSubgraph_four_of_commonVertexCycles",
    "Erdos641.not_hasCommonVertexCycles_of_four_free",
    "Erdos641.exists_four_regular_free_high_chromatic",
    "Erdos641.not_erdos_641",
    "Erdos641.eventually_exists_regularFree_not_colorable",
    "Erdos182.BipartiteGraph.containsRegularSubgraph_of_copy",
    "Erdos182.BipartiteGraph.containsRegularSubgraph_of_regular_support_mono"
  ],
  "environment": {
    "lean_toolchain": "leanprover/lean4:v4.33.0",
    "mathlib_commit": "db584cd6d46c92f209a44c0f1c829460d327499d",
    "LEAN_NUM_THREADS": "1",
    "compile_flags": [
      "-j1",
      "-M8192"
    ],
    "platform": "Windows"
  },
