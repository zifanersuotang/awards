      "paper_url": "https://arxiv.org/abs/2609.01766",
      "audit_source": "import Hilbert193.Continuity\n\n/-! Independent scope/axiom audit for the existing Cambie–Kalviainen proof.\nThis file does not claim authorship of the construction or its proof. -/\n\nnamespace JSP183Replay\n\n/-- The displayed witness has infinitely many distinct vertices. -/\ntheorem taggedLift_injective : Function.Injective Hilbert193.taggedLift := by\n  intro m n h\n  apply Hilbert193.taggedHeight_strictMono.injective\n  have hz := congrArg Hilbert193.Point3.z h\n  simpa only [Hilbert193.taggedLift, Nat.cast_inj] using hz\n\n/-- Re-expose the original theorem without adding mathematical hypotheses. -/\ntheorem original_statement :\n    ∃ (S : Set Hilbert193.Point3) (P : ℕ → Hilbert193.Point3),\n      S.Finite ∧\n      (∀ n, Hilbert193.displacement (P n) (P (n + 1)) ∈ S) ∧\n      (∀ ⦃i j k⦄, i < j → j < k →\n        ¬ Hilbert193.OrderedCollinear (P i) (P j) (P k)) :=\n  Hilbert193.erdos193_unconditional\n\n#print axioms taggedLift_injective\n#print axioms original_statement\n#print axioms Hilbert193.erdos193_unconditional\n#print axioms Hilbert193.taggedLift_no_three\n#print axioms Hilbert193.tagged_pair_law\n#print axioms Hilbert193.gaussian_same_state_pair_law\n\nend JSP183Replay\n\n",
      "axiom_audit_output": "'JSP183Replay.taggedLift_injective' depends on axioms: [propext, Classical.choice, Quot.sound]\n'JSP183Replay.original_statement' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Hilbert193.erdos193_unconditional' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Hilbert193.taggedLift_no_three' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Hilbert193.tagged_pair_law' depends on axioms: [propext, Classical.choice, Quot.sound]\n'Hilbert193.gaussian_same_state_pair_law' depends on axioms: [propext, Classical.choice, Quot.sound]\n"
    }
