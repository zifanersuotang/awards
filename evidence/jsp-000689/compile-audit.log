Erdos833.erdos_833.{u} :
  ∃ c,
    0 < c ∧
      ∀ (W : Type u) [inst : Fintype W] [inst_1 : DecidableEq W] (r : ℕ),
        2 ≤ r →
          ∀ (H : Erdos833.Hypergraph W),
            Erdos833.IsUniform H r → Erdos833.HasChromaticNumber H 3 → ∃ v, (1 + c) ^ r ≤ ↑(Erdos833.degree H v)
Erdos833.erdos_833_degree_bound.{u} {V : Type u} [Fintype V] [DecidableEq V] (H : Erdos833.Hypergraph V) (r : ℕ)
  (hr : 2 ≤ r) (hunif : Erdos833.IsUniform H r) (hχ : Erdos833.HasChromaticNumber H 3) :
  ∃ v, 2 ^ (r - 1) / (4 * ↑r) ≤ ↑(Erdos833.degree H v)
'Erdos833.erdos_833' depends on axioms: [propext, Classical.choice, Quot.sound]
