Erdos772.erdos_772 (k : ℕ) (_hk : 1 ≤ k) :
  Filter.Tendsto (fun n => ↑(Erdos772.H k n) / ↑n ^ (1 / 2)) Filter.atTop Filter.atTop ∧
    ∃ c, 0 < c ∧ ∀ᶠ (n : ℕ) in Filter.atTop, ↑n ^ (1 / 2 + c) < ↑(Erdos772.H k n)
'Erdos772.erdos_772' depends on axioms: [propext, Classical.choice, Quot.sound]
Erdos772.exists_sidon_finset_cubic (A : Finset ℕ) (k : ℕ)
  (hrep : ∀ (t : ℕ), {p ∈ A.product A | p.1 + p.2 = t}.card ≤ k) :
  ∃ S ⊆ A, Erdos772.IsSidon id S ∧ A.card ^ 2 ≤ 4096 * (k + 1) ^ 3 * S.card ^ 3
'Erdos772.exists_sidon_finset_cubic' depends on axioms: [propext, Classical.choice, Quot.sound]
Erdos772.H_real_rpow_lower_bound (k n : ℕ) : ↑n ^ (2 / 3) ≤ 16 * (↑k + 1) * ↑(Erdos772.H k n)
'Erdos772.H_real_rpow_lower_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
def Erdos772.Guarantees : ℕ → ℕ → ℕ → Prop :=
fun k n r =>
  ∀ (A : Finset ℕ),
    A.card = n → (∀ (t : ℕ), {p ∈ A.product A | p.1 + p.2 = t}.card ≤ k) → ∃ S ⊆ A, Erdos772.IsSidon id S ∧ r ≤ S.card
def Erdos772.IsSidon.{u_1} : {α : Type u_1} → [DecidableEq α] → (α → ℕ) → Finset α → Prop :=
fun {α} [DecidableEq α] a S => ∀ i ∈ S, ∀ j ∈ S, ∀ u ∈ S, ∀ v ∈ S, a i + a j = a u + a v → {i, j} = {u, v}
def Erdos772.H : ℕ → ℕ → ℕ :=
fun k n => (Erdos772.guaranteedSizes k n).max' ⋯
